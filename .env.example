# ===== LLM (Large Language Model) settings =====
# Main provider: gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Optional fallback (used only if the main LLM fails). Leave empty to disable.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# API keys - put real keys ONLY in your .env file, never in GitHub
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== Provider API endpoints =====
GEMINI_API_URL_TEMPLATE=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# 0 = turn off Gemini 2.5 "thinking" (faster + cheaper). Empty = model default.
GEMINI_THINKING_BUDGET=0
# Optional for OpenAI reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=

# ===== Website fetching =====
FETCH_TIMEOUT_SECONDS=15
JS_RENDER_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=3000000
MAX_REDIRECTS=5
MAX_EXTRA_PAGES=2
MAX_CONTENT_CHARS=12000

# ===== Other =====
LLM_TIMEOUT_SECONDS=90
MAX_OUTPUT_TOKENS=8000
CACHE_TTL_SECONDS=3600
